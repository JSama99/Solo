    "appInfoLocalization:en-US": {
      "fields": {
        "name": "SOLO: Unicorn Run",
        "privacyPolicyUrl": "https://www.talonsight.com/privacy",
        "subtitle": "Lead Your AI Workforce"
      },
      "id": "783c7ec9-0e87-418b-a1bb-de572eaab12c",
