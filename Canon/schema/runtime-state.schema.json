{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solo-runtime-state-0.1",
  "title": "Already-authorized SOLO runtime knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_version", "knowledge"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "state_version": {"type": "integer", "minimum": 0},
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "summary", "visibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^runtime\\.[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
          "kind": {"enum": ["event", "fact", "assignment", "metric"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "visibility": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["public", "founder", "aurora", "stacks", "brio", "agent_shared", "signal_tv", "tech_com", "media_shared", "rival", "simulation_internal"]}
          }
        }
      }
    }
  }
}
