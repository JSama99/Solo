{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solo-canon-manifest-0.1",
  "title": "SOLO Canon manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canon_version", "generated_from", "record_count", "records"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "canon_version": {"const": "C0"},
    "generated_from": {"const": "Canon/records/**/*.json"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "status", "authority", "path", "sha256", "visibility"], "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "status": {"type": "string"}, "authority": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "visibility": {"type": "array", "items": {"type": "string"}}}}}
  }
}
