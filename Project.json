{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "SoloUnicornRun",
  "packages": {
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios-spm.git",
      "from": "5.43.0"
    }
  },
  "options": {
    "groupSortPosition": "bottom",
    "developmentLanguage": "en",
    "transitivelyLinkDependencies": false,
    "deploymentTarget": {
      "iOS": "18.0"
    }
  },
  "settings": {},
  "schemes": {
    "Solo Unicorn Run": {
      "build": {
        "targets": {
          "Solo Unicorn Run": "all",
          "Solo Unicorn Run Tests": [
            "test"
          ],
          "Solo Unicorn Run UI Tests": [
            "test"
          ]
        }
      },
      "run": {
        "config": "Debug"
      },
      "test": {
        "config": "Debug",
        "targets": [
          "Solo Unicorn Run Tests",
          "Solo Unicorn Run UI Tests"
        ]
      }
    }
  },
  "targets": {
    "Solo Unicorn Run": {
      "attributes": {
        "SystemCapabilities": {
          "com.apple.InAppPurchase": {
            "enabled": 1
          }
        }
      },
      "dependencies": [
        {
          "package": "RevenueCat",
          "product": "RevenueCat"
        },
        {
          "package": "RevenueCat",
          "product": "RevenueCatUI"
        }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "SOLO: Unicorn Run",
          "CFBundleShortVersionString": "32.7.4",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "ITSAppUsesNonExemptEncryption": false,
          "RevenueCatAPIKey": "$(REVENUECAT_API_KEY)",
          "UILaunchScreen": {
            "UIColorName": "LaunchBackground"
          },
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "base": {
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
          "CURRENT_PROJECT_VERSION": "32704",
          "CODE_SIGN_IDENTITY": "Apple Development",
          "CODE_SIGN_STYLE": "Automatic",
          "MARKETING_VERSION": "32.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.talonsight.solounicornrun",
          "PRODUCT_MODULE_NAME": "Solo_Unicorn_Run",
          "PRODUCT_NAME": "$(TARGET_NAME)",
          "REVENUECAT_API_KEY": "appl_RstJigxejEkEbYZmARYTVpcBoxY",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2"
        }
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    },
    "Solo Unicorn Run Tests": {
      "dependencies": [
        {
          "target": "Solo Unicorn Run"
        }
      ],
      "platform": "iOS",
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": "YES",
          "CODE_SIGN_IDENTITY": "Apple Development",
          "CODE_SIGN_STYLE": "Automatic",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.talonsight.solounicornrun.tests",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2"
        }
      },
      "sources": [
        {
          "path": "Tests"
        }
      ],
      "type": "bundle.unit-test"
    },
    "Solo Unicorn Run UI Tests": {
      "dependencies": [
        {
          "target": "Solo Unicorn Run"
        }
      ],
      "platform": "iOS",
      "settings": {
        "base": {
          "CODE_SIGN_IDENTITY": "Apple Development",
          "CODE_SIGN_STYLE": "Automatic",
          "GENERATE_INFOPLIST_FILE": "YES",
          "PRODUCT_BUNDLE_IDENTIFIER": "com.talonsight.solounicornrun.uitests",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "TEST_TARGET_NAME": "Solo Unicorn Run"
        }
      },
      "sources": [
        {
          "path": "UITests"
        }
      ],
      "type": "bundle.ui-testing"
    }
  }
}
