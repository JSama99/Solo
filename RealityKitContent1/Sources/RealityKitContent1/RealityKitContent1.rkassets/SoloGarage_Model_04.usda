    def Scope "Materials"
    {
        def Material "GarageMaterial"
        {
            token outputs:surface.connect = </SoloGarage_Model_04/Materials/GarageMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </SoloGarage_Model_04/Materials/GarageMaterial/BaseColorTexture.outputs:rgb>
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 1
                token outputs:surface
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @SoloGarage_Model_04_BaseColor.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </SoloGarage_Model_04/Materials/GarageMaterial/TextureCoordinates.outputs:result>
                float outputs:a
                float3 outputs:rgb
            }

            def Shader "TextureCoordinates"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }
