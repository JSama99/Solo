+  func testStandingsWithMovesStillSumMarketShareToOne() {
+    for sprint in 1...12 {
+      let standings = RivalEngine.standings(
+        companies: ContentLibrary.rivalSimulationCompanies,
+        venture: 3,
+        sprint: sprint,
