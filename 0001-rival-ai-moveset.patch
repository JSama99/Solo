+  func testOverreachIsAlwaysAPenaltyAndFundraiseSurgeIsAlwaysTheBiggestSingleGain() {
+    let rival = RivalCompany(id: "bounds-check", name: "Bounds Check Co", archetype: .hypeMachine, debutVenture: 1, baseStrength: 1)
+    for venture in 1...3 {
+      for sprint in 1...12 {
