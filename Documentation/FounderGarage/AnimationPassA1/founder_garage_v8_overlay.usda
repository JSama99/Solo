#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    prepend references = @founder_garage_v7_base.usdc@</root>
)
{
    over "FounderGarage"
    {
        over "Shell"
        {
            def Xform "RightSideAccessDoor"
            {
                custom string userProperties:SOLO_role = "right_side_personnel_door"
                custom string userProperties:dimensions_m = "0.98 x 2.18 x 0.12"

                def Cube "RightSideAccessDoor_Panel" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Painted_Teal>
                    double3 xformOp:scale = (0.055, 1.01, 0.43)
                    double3 xformOp:translate = (2.475, 1.06, 0.78)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RightSideAccessDoor_JambRear" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Metal_Black>
                    double3 xformOp:scale = (0.075, 1.09, 0.045)
                    double3 xformOp:translate = (2.445, 1.09, 0.30)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RightSideAccessDoor_JambFront" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Metal_Black>
                    double3 xformOp:scale = (0.075, 1.09, 0.045)
                    double3 xformOp:translate = (2.445, 1.09, 1.26)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RightSideAccessDoor_Header" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Metal_Black>
                    double3 xformOp:scale = (0.075, 0.05, 0.525)
                    double3 xformOp:translate = (2.445, 2.13, 0.78)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RightSideAccessDoor_Threshold" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Metal_Brushed>
                    double3 xformOp:scale = (0.14, 0.025, 0.50)
                    double3 xformOp:translate = (2.43, 0.025, 0.78)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cube "RightSideAccessDoor_HandlePlate" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1
                    rel material:binding = </root/_materials/MAT_Metal_Black>
                    double3 xformOp:scale = (0.035, 0.09, 0.055)
                    double3 xformOp:translate = (2.405, 1.00, 0.48)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cylinder "RightSideAccessDoor_Handle" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    uniform token axis = "X"
                    double height = 0.11
                    double radius = 0.024
                    rel material:binding = </root/_materials/MAT_Metal_Brushed>
                    double3 xformOp:translate = (2.34, 1.00, 0.48)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }
        }
    }
}
